# Copie ce fichier en .env.local et remplis avec tes vraies valeurs.
# NE METS JAMAIS de vraie clé ici (ce fichier est versionné sur Git).
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-anon-publique
# Clé service (secrète — NE JAMAIS exposer côté client ni la committer)
SUPABASE_SERVICE_ROLE_KEY=cle-service-role-secrete
# URL publique (local : http://localhost:3000 ; prod : https://ton-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Compte fixe (connexion automatique, sans page de login) — côté serveur uniquement.
# Crée d'abord cet utilisateur dans Supabase → Authentication → Users → Add user (Auto Confirm).
APP_USER_EMAIL=contact@parisandko.com
APP_USER_PASSWORD=ton-mot-de-passe
